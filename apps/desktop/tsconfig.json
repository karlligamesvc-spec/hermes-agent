{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@hermes/plugin-sdk": ["./src/sdk/index.ts"],
      "@hermes/shared/billing": ["../shared/src/billing-types.ts"],
      "@hermes/shared/billing-policy": ["../shared/src/billing-policy.ts"],
      "@hermes/shared/charge-settlement": ["../shared/src/charge-settlement.ts"],
      "@hermes/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "../shared/src"],
  // The fork's pre-v0.19.0 shell pair. Upstream replaced the whole shell in
  // v0.19.0 — `src/app/index.tsx` now renders the contribution controller
  // (src/app/contrib), and the Pane / PaneMain / PaneShell components these two
  // are built on no longer exist; pane layout is a tree renderer. Nothing
  // imports them, so they are already out of the bundle, but they are the only
  // record of how the ApexNodes views (im-entry / profile / search / tasks /
  // the scenario session bridge) were mounted, so they stay in the tree as the
  // reference for the re-wiring leg rather than being deleted. Type-checking a
  // shell written against a deleted API can only report that fact.
  "exclude": ["src/app/desktop-controller.tsx", "src/app/shell/app-shell.tsx"],
  "references": [{ "path": "./tsconfig.electron.json" }]
}
