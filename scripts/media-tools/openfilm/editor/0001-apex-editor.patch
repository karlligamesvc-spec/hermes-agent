new file mode 100644
index 0000000..fd2ffd0
--- /dev/null
+++ b/studio/ui/apex/brand.mjs
@@ -0,0 +1,33 @@
+/**
+ * APEX's editor (hc-1188) never shows the OpenFilm name: a modified OpenFilm may not carry it (OpenFilm's trademark
+ * terms). `withoutBrand` rewrites a text in one of Studio's languages so that where it named OpenFilm it says "the
+ * editor", as that language says it at the start of a sentence and inside one. vite.config.ts runs it over each
+ * language's table (src/i18n/<code>.ts) as the editor is built, so the built editor holds no such phrase at all.
+ */
+
+/** the editor, in each language: as a sentence (or a quoted phrase) begins it, inside one, and as an owner */
+export const EDITOR = {
+  en: { start: 'The editor', inside: 'the editor', owner: ['The editor’s', 'the editor’s'] },
+  'zh-CN': { start: '编辑器', inside: '编辑器' },
+  ja: { start: 'エディター', inside: 'エディター' },
+  ko: { start: '편집기', inside: '편집기' },
+  es: { start: 'El editor', inside: 'el editor' },
+};
+
+/** Languages written without spaces between words: the name's own spaces go with it, but beside a Latin word. */
+const UNSPACED = new Set(['zh-CN', 'ja']);
+
+/** `text` (a phrase, or a whole table's source) in `language`, with "the editor" where it named OpenFilm. */
+export function withoutBrand(text, language) {
+  const word = EDITOR[language] ?? EDITOR.en;
+  /* English already saying "the" before the name: the editor, not "the the editor" */
+  const said = word === EDITOR.en ? text.replace(/\b([Tt]he) OpenFilm(['’]s)?/g, (_, the, owned) => `${the} editor${owned ? '’s' : ''}`) : text;
+  return said.replace(/( ?)OpenFilm(['’]s)?( ?)/g, (match, lead, owned, trail, at, all) => {
+    const before = all.slice(0, at);
+    const start = /(^|[.!?:。！？：'"`]\s*)$/.test(before + lead);
+    const term = owned && word.owner ? word.owner[start ? 0 : 1] : start ? word.start : word.inside;
+    if (!UNSPACED.has(language)) return `${lead}${term}${trail}`;
+    const after = all[at + match.length] ?? '';
+    return `${/[A-Za-z0-9}]$/.test(before) ? lead : ''}${term}${/^[A-Za-z0-9{]/.test(after) ? trail : ''}`;
+  });
+}
