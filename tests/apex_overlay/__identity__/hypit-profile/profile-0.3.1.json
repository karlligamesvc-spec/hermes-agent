{
  "format": "hypit.runtime-local@1",
  "dataRoot": "apex-runtime-data",
  "endpoints": {
    "media.local": {
      "use": "@hypit/media-local",
      "config": {
        "ffmpegPath": "<FFMPEG>",
        "ffprobePath": "<FFPROBE>"
      }
    },
    "html.local": {
      "use": "@hypit/provider-html-local",
      "config": {
        "ffmpegPath": "<FFMPEG>",
        "ffprobePath": "<FFPROBE>",
        "chromePath": "<BROWSER>"
      }
    }
  }
}